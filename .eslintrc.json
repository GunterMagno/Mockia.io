{
  "root": true,
  "ignorePatterns": [
    "node_modules/",
    "dist/",
    "build/",
    "coverage/",
    "/~/",
    "/.tmp-repos/",
    "/.superpowers/",
    "/.claude/",
    "packages/backend/scratch/",
    "packages/backend/scratch-check.js",
    "packages/backend/.tmp-repos/",
    "packages/frontend/public/",
    "packages/frontend/cypress/downloads/",
    "packages/frontend/cypress/screenshots/",
    "packages/frontend/vite.config.js",
    "packages/frontend/vite.config.d.ts"
  ],
  "env": {
    "node": true,
    "es2021": true
  },
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/recommended",
    "plugin:prettier/recommended"
  ],
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "plugins": ["@typescript-eslint"],
  "rules": {
    "no-console": "warn",
    "no-debugger": "warn",
    // Convencion: lo que empieza por _ se ignora (argumentos, variables y propiedades descartadas con rest)
    "@typescript-eslint/no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "ignoreRestSiblings": true
      }
    ],
    // El tipo vacio es el valor habitual de los genericos de Express (Request<{}, {}, Body>) para params y query;
    // el resto de tipos prohibidos por la regla (Object, Function...) siguen prohibidos
    "@typescript-eslint/ban-types": ["error", { "extendDefaults": true, "types": { "{}": false } }],
    "@typescript-eslint/explicit-function-return-types": "off",
    "@typescript-eslint/no-explicit-any": "warn",
    "prettier/prettier": "error"
  },
  "overrides": [
    {
      "files": ["packages/frontend/**/*.{ts,tsx}"],
      "extends": [
        "eslint:recommended",
        "plugin:@typescript-eslint/recommended",
        "plugin:react/recommended",
        "plugin:react-hooks/recommended",
        "plugin:prettier/recommended"
      ],
      "parser": "@typescript-eslint/parser",
      "parserOptions": {
        "ecmaVersion": "latest",
        "sourceType": "module",
        "ecmaFeatures": {
          "jsx": true
        }
      },
      "plugins": ["@typescript-eslint", "react", "react-hooks"],
      "settings": {
        "react": {
          "version": "detect"
        }
      },
      "rules": {
        // El "extends" de este override reactivaba no-explicit-any como error y hacia que el frontend fuese mas
        // estricto que el backend; se mantiene la politica comun (aviso) hasta tipar los catch y las respuestas
        "@typescript-eslint/no-explicit-any": "warn",
        "react/react-in-jsx-scope": "off",
        "react/prop-types": "off",
        "react-hooks/rules-of-hooks": "error",
        "react-hooks/exhaustive-deps": "warn"
      }
    },
    {
      // Elementos de react-three-fiber (<icosahedronGeometry args=...>, <meshBasicMaterial wireframe .../>): sus
      // props no son atributos DOM y react/no-unknown-property no las conoce
      "files": ["packages/frontend/src/pages/Landing/HeroScene.tsx"],
      "rules": {
        "react/no-unknown-property": "off"
      }
    }
  ]
}
