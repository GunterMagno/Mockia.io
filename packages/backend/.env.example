# Backend Configuration
NODE_ENV=development
BACKEND_PORT=3000

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/mockia

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# JWT Configuration
# Access tokens expire after 15 minutes (the client keeps them in memory only)
# Refresh tokens expire after 7 days and travel only in an HttpOnly cookie
# In production, use strong random secrets (minimum 32 characters)
JWT_ACCESS_SECRET=your_access_secret_change_in_production
JWT_REFRESH_SECRET=your_refresh_secret_change_in_production
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRE=7d

# Session cookie (refresh token, HttpOnly cookie "mockia_rt", Path=/api/auth, Secure when NODE_ENV=production)
# SameSite: lax (default) | strict | none. Lax cookies are only sent on same-site requests, so production must serve the
# SPA and /api from ONE origin (nginx.conf in docker-compose.prod, the /api/* rewrite in render.yaml). Use none only
# when frontend and backend live on different sites: it forces Secure (HTTPS) and needs an explicit CORS_ORIGIN.
COOKIE_SAMESITE=lax

# Max login/register attempts per IP per 15 min (brute-force limit, default 20). Only raise it for the e2e suite.
# AUTH_RATE_LIMIT_MAX=20

# Logging
LOG_LEVEL=debug

# Billing (Stripe). Without these, the app runs on the free plan only and the billing page
# explains that online payments are not enabled. Use test-mode keys (sk_test_...) locally.
# 1. Dashboard > Products: create "Pro" (29 USD/month) and "Team" (99 USD/month); copy each price id.
# 2. Dashboard > Settings > Billing > Customer portal: save a configuration (add both prices to allow plan switching).
# 3. Webhook endpoint https://<your-host>/api/billing/webhook with events:
#    checkout.session.completed, customer.subscription.created, customer.subscription.updated, customer.subscription.deleted
#    Locally: stripe listen --forward-to localhost:3000/api/billing/webhook (prints the whsec_ secret).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=
# Where Stripe sends the user back (defaults to FRONTEND_URL or the first CORS_ORIGIN + /billing)
FRONTEND_URL=http://localhost:5173
