# Backend Configuration
NODE_ENV=development
BACKEND_PORT=3000

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/mockia

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# JWT Configuration
# Access tokens expire after 15 minutes (the client keeps them in memory only)
# Refresh tokens expire after 7 days and travel only in an HttpOnly cookie
# In production, use strong random secrets (minimum 32 characters)
JWT_ACCESS_SECRET=your_access_secret_change_in_production
JWT_REFRESH_SECRET=your_refresh_secret_change_in_production
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRE=7d

# Session cookie (refresh token, HttpOnly cookie "mockia_rt", Path=/api/auth, Secure when NODE_ENV=production)
# SameSite: lax (default) | strict | none. Lax cookies are only sent on same-site requests, so production must serve the
# SPA and /api from ONE origin (nginx.conf in docker-compose.prod, the /api/* rewrite in render.yaml). Use none only
# when frontend and backend live on different sites: it forces Secure (HTTPS) and needs an explicit CORS_ORIGIN.
COOKIE_SAMESITE=lax

# AI providers, in order of preference: "openrouter" (default) or "local,openrouter" (own model first, OpenRouter as reserve).
# The local one is any OpenAI-compatible server (Ollama, vLLM, llama.cpp). AI_LOCAL_BASE_URL is the server root WITHOUT /v1.
# AI_PROVIDERS=openrouter
# AI_LOCAL_BASE_URL=http://localhost:11434
# AI_LOCAL_MODEL=qwen2.5-coder:7b-instruct
# AI_LOCAL_TIMEOUT_MS=120000
# AI_LOCAL_API_KEY=
# AI calls per user per minute (default 20)
# AI_RATE_PER_MINUTE=20
# Days the generations of users who opted in to improving the AI are kept (default 180)
# AI_GENERATION_RETENTION_DAYS=180
# Overall budget of one AI request across all providers (default 240000); keep it below the proxy read timeout (300 s)
# AI_TOTAL_TIMEOUT_MS=240000
# 1 = send OpenRouter the strict json_schema (only for models that support structured outputs); default: json_object
# OPENROUTER_JSON_SCHEMA=

# Max login/register attempts per IP per 15 min (brute-force limit, default 20). Only raise it for the e2e suite.
# AUTH_RATE_LIMIT_MAX=20

# Transactional email (verification and password reset links). Without SMTP_URL nothing is sent:
#   development -> the link is printed in the backend console
#   production  -> an error is logged and users receive no email (AI generation and billing stay locked for unverified users)
# Use a provider with a free plan, e.g. Resend (smtp://resend:<API_KEY>@smtp.resend.com:465) or Brevo
# (smtp://<login>:<SMTP_KEY>@smtp-relay.brevo.com:587). MAIL_FROM must be an address on a domain you verified with the
# provider; publish the SPF and DKIM records they give you, or the messages land in spam. Details: docs/08_despliegue.md.
# SMTP_URL=smtp://user:password@smtp.example.com:587
# MAIL_FROM=Mockia.io <no-reply@yourdomain.com>
# Public URL of the SPA used in the email links (${APP_URL}/reset-password?token=..., ${APP_URL}/verify-email?token=...).
# Mandatory in production; locally it falls back to FRONTEND_URL / CORS_ORIGIN.
# APP_URL=http://localhost:5173

# Email verification gate for AI generation and the billing checkout / portal.
# Unset = enforced only when NODE_ENV=production. Before enabling it on a database that already has users, run
#   npm run backfill:email-verified -w @mockia/backend
# once, or those accounts are locked out until they verify.
# REQUIRE_EMAIL_VERIFICATION=false

# E2E ONLY (Cypress): keeps the emails in memory and serves them at GET /api/__test__/outbox.
# The backend refuses to boot in production with this enabled (it would expose password reset links).
# E2E_EXPOSE_MAIL_OUTBOX=true

# Logging
LOG_LEVEL=debug

# Billing (Stripe). Without these, the app runs on the free plan only and the billing page
# explains that online payments are not enabled. Use test-mode keys (sk_test_...) locally.
# 1. Dashboard > Products: create "Pro" and "Team", each with a monthly price (29 / 99 USD) and a yearly price (290 / 990 USD,
#    10 months a year); copy the four price ids. See docs/pagos.md.
# 2. Dashboard > Settings > Billing > Customer portal: save a configuration (add both prices to allow plan switching).
# 3. Webhook endpoint https://<your-host>/api/billing/webhook with events:
#    checkout.session.completed, customer.subscription.created, customer.subscription.updated, customer.subscription.deleted
#    Locally: stripe listen --forward-to localhost:3000/api/billing/webhook (prints the whsec_ secret).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_TEAM_YEARLY=
# Where Stripe sends the user back (defaults to FRONTEND_URL or the first CORS_ORIGIN + /billing)
FRONTEND_URL=http://localhost:5173

# --- Public demo (anonymous AI generation without an account) ---------------------------------------------------
# OFF by default. To open it: DEMO_ENABLED=true and a random DEMO_HMAC_SECRET (>= 32 chars; it signs the proof-of-work
# challenges and pseudonymizes visitor IPs, so rotating it only invalidates pending challenges).
# DEMO_ENABLED=false
# DEMO_HMAC_SECRET=
# DEMO_DAILY_GENERATIONS=150
# DEMO_PER_IP_GENERATIONS=2
# DEMO_MAX_CONCURRENT=4
# DEMO_POW_BITS=18
# DEMO_MOCK_TTL_MINUTES=30
# Optional: provider list for the DEMO only (same syntax as AI_PROVIDERS, e.g. a cheaper or local model). Empty = use AI_PROVIDERS.
# The demo never uses more than 1500 output tokens per generation and at most 5 endpoints, whatever the model.
# AI_DEMO_PROVIDERS=
