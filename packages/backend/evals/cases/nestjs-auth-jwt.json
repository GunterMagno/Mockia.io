      },
      "responseSchema": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "refreshToken": {
            "type": "string"
          }
        },
        "required": [
          "accessToken",
          "refreshToken"
        ]
      },
      "examples": [
        {
          "request": {
            "refreshToken": "eyJhbGciOiJIUzI1NiJ9.refresh"
          },
          "response": {
            "accessToken": "eyJhbGciOiJIUzI1NiJ9.access2",
            "refreshToken": "eyJhbGciOiJIUzI1NiJ9.refresh2"
