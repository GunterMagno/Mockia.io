# Frontend Development Dockerfile with hot-reload support
FROM node:20-alpine

WORKDIR /app

# Install development dependencies
RUN npm install -g npm@latest

# Copy root package files and workspace structure
COPY package.json package-lock.json ./
COPY packages/frontend/package.json ./packages/frontend/
COPY packages/shared/package.json ./packages/shared/
COPY packages/shared/tsconfig.json ./packages/shared/
COPY packages/shared/src ./packages/shared/src

# Install dependencies
RUN npm install

# Build shared package (needed by frontend)
RUN npm run build --workspace=packages/shared

# Create src directory
RUN mkdir -p src

# Expose port (Vite default)
EXPOSE 5173

# Set host to 0.0.0.0 to allow external connections
ENV VITE_HOST=0.0.0.0

# Default command (will be overridden by docker-compose)
CMD ["npm", "run", "dev"]
