# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending every file
[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8
trim_trailing_whitespace = true

# 2 space indentation for TypeScript, JavaScript, JSON, YAML, Markdown
[*.{ts,tsx,js,jsx,json,yaml,yml,md}]
indent_style = space
indent_size = 2

# 2 space indentation for HTML, CSS, SCSS, LESS
[*.{html,css,scss,less}]
indent_style = space
indent_size = 2

# Dockerfile
[Dockerfile*]
indent_style = space
indent_size = 2

# Makefile
[Makefile]
indent_style = tab
