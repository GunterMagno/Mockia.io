# Database Configuration
MONGODB_URI=mongodb://mongo:27017/mockia

# Authentication
JWT_SECRET=your-jwt-secret-key-change-this-in-production
JWT_REFRESH_SECRET=your-jwt-refresh-secret-key-change-this-in-production

# OpenRouter AI Integration (SPRINT 5)
# Get your API key from https://openrouter.ai
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_MODEL=meta-llama/llama-2-7b-chat
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Retry Configuration
MAX_RETRIES=3
INITIAL_RETRY_DELAY_MS=1000
MAX_RETRY_DELAY_MS=30000

# Backend Configuration
BACKEND_PORT=3000
BACKEND_HOST=0.0.0.0
NODE_ENV=development
APP_URL=http://localhost:3000

# Frontend Configuration
FRONTEND_PORT=5173
FRONTEND_HOST=0.0.0.0
VITE_API_URL=http://localhost:3000/api
CORS_ORIGIN=http://localhost:5173

# MongoDB Configuration
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=password

# Logging
LOG_LEVEL=debug