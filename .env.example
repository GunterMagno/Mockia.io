# Mockia.io - plantilla de variables de entorno. Copiala a .env y rellenala.
#
# Los valores de abajo sirven para desarrollo local. En PRODUCCION (docker-compose.prod.yml / Render) las
# variables marcadas [PROD] son obligatorias y deben tener un valor real: docker-compose.prod.yml aborta si
# falta alguna y el backend se niega a arrancar (NODE_ENV=production) si CORS_ORIGIN es "*" o esta vacio,
# si la contrasena de Mongo es la de por defecto, si falta APP_URL o si un JWT_* es un valor por defecto,
# un placeholder tipo "change-me" o tiene menos de 32 caracteres.

# Database Configuration
MONGODB_URI=mongodb://mongo:27017/mockia

# Authentication [PROD]
# Minimo 32 caracteres y distintos entre si. Genera cada uno con:  openssl rand -hex 48
JWT_ACCESS_SECRET=change-me-dev-only-access-secret-0123456789
JWT_REFRESH_SECRET=change-me-dev-only-refresh-secret-9876543210

# OpenRouter AI Integration (SPRINT 5)
# Get your API key from https://openrouter.ai
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_MODEL=meta-llama/llama-2-7b-chat
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Retry Configuration
MAX_RETRIES=3
INITIAL_RETRY_DELAY_MS=1000
MAX_RETRY_DELAY_MS=30000

# Backend Configuration
BACKEND_PORT=3000
BACKEND_HOST=0.0.0.0
NODE_ENV=development
# [PROD] URL publica de la aplicacion (p. ej. https://app.midominio.com)
APP_URL=http://localhost:3000

# Correo transaccional [PROD]: enlaces de verificacion de email y de recuperar contrasena.
# Resend (smtp://resend:<API_KEY>@smtp.resend.com:465) o Brevo (smtp://<login>:<clave>@smtp-relay.brevo.com:587), ambos con
# plan gratuito. MAIL_FROM debe ser de un dominio verificado en el proveedor (publica sus registros SPF y DKIM).
# Sin SMTP_URL el backend arranca igual pero nadie recibe correos (ver docs/08_despliegue.md).
SMTP_URL=
MAIL_FROM=
# Vacio = el correo verificado solo se exige en produccion. Antes de activarlo con usuarios existentes:
# npm run backfill:email-verified -w @mockia/backend
REQUIRE_EMAIL_VERIFICATION=

# Pagos con Stripe [PROD si se cobran suscripciones]. Sin ellas el backend arranca, pero /billing/checkout
# responde 501 y no hay cobro. Alta de cuenta, productos, Stripe Tax, webhook y pruebas: docs/pagos.md
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=

# Frontend Configuration
FRONTEND_PORT=5173
FRONTEND_HOST=0.0.0.0
VITE_API_URL=http://localhost:3000/api
# Titular del servicio [PROD, OBLIGATORIO]: lo publican el Aviso Legal (LSSI art. 10) y la Politica de Privacidad (RGPD art. 13).
# `vite build` en modo produccion FALLA si NAME, NIF, ADDRESS o EMAIL estan vacios. En desarrollo se ven marcadores
# "[... - pendiente]". Vite lee estas variables del entorno o de packages/frontend/.env.local; con Docker se pasan como
# build args (docker-compose.prod.yml) y en Render se definen en el servicio mockia-frontend (render.yaml, sync: false).
VITE_LEGAL_NAME=
VITE_LEGAL_NIF=
VITE_LEGAL_ADDRESS=
VITE_LEGAL_EMAIL=
# Datos registrales (p. ej. Registro Mercantil): opcional.
VITE_LEGAL_REGISTRY=
# Solo CI/pruebas: 1 permite compilar para produccion con marcadores en lugar de los datos. NUNCA en un despliegue real.
VITE_LEGAL_ALLOW_PLACEHOLDER=
# [PROD] Origen(es) explicito(s) del frontend, separados por comas. Nunca "*".
CORS_ORIGIN=http://localhost:5173

# MongoDB Configuration [PROD]
# Estos valores van incrustados en MONGODB_URI: usa solo caracteres seguros para URL (openssl rand -hex 24).
# La contrasena "password" solo vale en desarrollo; con ella el backend no arranca en produccion.
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=password

# Logging
LOG_LEVEL=debug
