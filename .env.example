# Mockia.io - plantilla de variables de entorno. Copiala a .env y rellenala.
#
# Los valores de abajo sirven para desarrollo local. En PRODUCCION (docker-compose.prod.yml / Render) las
# variables marcadas [PROD] son obligatorias y deben tener un valor real: docker-compose.prod.yml aborta si
# falta alguna y el backend se niega a arrancar (NODE_ENV=production) si CORS_ORIGIN es "*" o esta vacio,
# si la contrasena de Mongo es la de por defecto, si falta APP_URL o si un JWT_* es un valor por defecto,
# un placeholder tipo "change-me" o tiene menos de 32 caracteres.

# Database Configuration
MONGODB_URI=mongodb://mongo:27017/mockia

# Authentication [PROD]
# Minimo 32 caracteres y distintos entre si. Genera cada uno con:  openssl rand -hex 48
JWT_ACCESS_SECRET=change-me-dev-only-access-secret-0123456789
JWT_REFRESH_SECRET=change-me-dev-only-refresh-secret-9876543210

# OpenRouter AI Integration (SPRINT 5)
# Get your API key from https://openrouter.ai
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_MODEL=meta-llama/llama-2-7b-chat
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# AI providers, in order of preference. "openrouter" (default) or "local,openrouter" to try an open-source model on your
# own server first (Ollama, vLLM or llama.cpp: anything that serves POST /v1/chat/completions) and fall back to
# OpenRouter when it is down, slow or answers nothing useful. After 3 consecutive failures the local one is skipped for
# 60 s so a stopped model does not slow every request. Unknown names are ignored with a warning.
AI_PROVIDERS=openrouter
# Server ROOT of the local model, WITHOUT /v1 (e.g. http://llm:11434). Required in production when AI_PROVIDERS has "local".
AI_LOCAL_BASE_URL=
AI_LOCAL_MODEL=qwen2.5-coder:7b-instruct
# Cold model loads are slow: 120000 ms by default.
AI_LOCAL_TIMEOUT_MS=120000
# Only if the local server requires a key (vLLM --api-key). Ollama needs none.
AI_LOCAL_API_KEY=
# AI generation calls one user may start per minute (kept in Mongo, shared by all instances). Default 20.
AI_RATE_PER_MINUTE=20
# Days the AI generations of users who OPTED IN to improving the AI (prompts, answers, corrections) are kept before the TTL
# index deletes them. Default 180. Nothing is stored for users who did not opt in.
AI_GENERATION_RETENTION_DAYS=180
# Overall budget of ONE AI request across every provider (local attempt + fallback + retries). When it runs out the
# request ends with a 504 instead of continuing. Must stay below the front proxy read timeout (nginx /api/ai/: 300 s).
AI_TOTAL_TIMEOUT_MS=240000
# The endpoint generation asks for strict structured output (json_schema). The local model gets it as is; OpenRouter gets
# the lighter json_object unless this is 1 (only set it when OPENROUTER_MODEL supports structured outputs, others answer 400).
OPENROUTER_JSON_SCHEMA=
# Temperature of endpoint generation (0-2). Empty = 0.85. Tune it only after comparing runs of the evaluation bench.
AI_SPEC_TEMPERATURE=

# Servicio de IA propia en Docker (docker-compose.ai.yml / .ai.gpu.yml / .ai.vllm.yml; guia: docs/ia-local.md).
# Incluir esos ficheros NO activa el modelo: sigue mandando AI_PROVIDERS (openrouter por defecto). Con ellos,
# AI_LOCAL_BASE_URL vacia vale http://llm:11434 (Ollama) o http://llm:8000 (vLLM); no la apuntes a otro sitio si usas compose.
# Etiqueta de la imagen de Ollama (verifica que existe en https://hub.docker.com/r/ollama/ollama/tags antes de subirla).
# OLLAMA_IMAGE=ollama/ollama:0.6.5
# Peticiones simultaneas por modelo (cada una reserva su contexto: mas memoria).
# OLLAMA_NUM_PARALLEL=1
# Contexto de Ollama en tokens (minimo 16384: repo 6000 + prompt de sistema + 5000 de salida; mas contexto = mas memoria).
# OLLAMA_CONTEXT_LENGTH=16384
# Tope de memoria del contenedor llm (8g para un 7B cuantizado en Ollama; 16g por defecto con vLLM).
# LLM_MEM_LIMIT=8g
# vLLM (solo GPU NVIDIA): imagen, modelo de Hugging Face, contexto maximo, fraccion de VRAM y token (solo modelos restringidos).
# VLLM_IMAGE=vllm/vllm-openai:v0.8.5
# VLLM_MODEL=Qwen/Qwen2.5-Coder-7B-Instruct
# VLLM_MAX_MODEL_LEN=16384
# VLLM_GPU_MEMORY_UTILIZATION=0.90
# HF_TOKEN=
# Ficheros de compose que usa scripts/pull-model.sh (separados por espacios; por defecto produccion + Ollama).
# COMPOSE_FILES=docker-compose.prod.yml docker-compose.ai.yml

# Retry Configuration
MAX_RETRIES=3
INITIAL_RETRY_DELAY_MS=1000
MAX_RETRY_DELAY_MS=30000

# Backend Configuration
BACKEND_PORT=3000
BACKEND_HOST=0.0.0.0
NODE_ENV=development
# [PROD] URL publica de la aplicacion (p. ej. https://app.midominio.com)
APP_URL=http://localhost:3000

# Correo transaccional [PROD]: enlaces de verificacion de email y de recuperar contrasena.
# Resend (smtp://resend:<API_KEY>@smtp.resend.com:465) o Brevo (smtp://<login>:<clave>@smtp-relay.brevo.com:587), ambos con
# plan gratuito. MAIL_FROM debe ser de un dominio verificado en el proveedor (publica sus registros SPF y DKIM).
# Sin SMTP_URL el backend arranca igual pero nadie recibe correos (ver docs/08_despliegue.md).
SMTP_URL=
MAIL_FROM=
# Vacio = el correo verificado solo se exige en produccion. Antes de activarlo con usuarios existentes:
# npm run backfill:email-verified -w @mockia/backend
REQUIRE_EMAIL_VERIFICATION=

# Pagos con Stripe [PROD si se cobran suscripciones]. Sin ellas el backend arranca, pero /billing/checkout
# responde 501 y no hay cobro. Alta de cuenta, productos, Stripe Tax, webhook y pruebas: docs/pagos.md
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Precios mensuales: Starter (5 USD), Pro (29) y Team (99). Vacio = no configurado (el checkout de ese plan responde 501).
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=
# Precios anuales (10 meses al ano, dos gratis). Si faltan, el checkout anual responde 501 y la web no ofrece comprar al ano.
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_TEAM_YEARLY=

# Frontend Configuration
FRONTEND_PORT=5173
FRONTEND_HOST=0.0.0.0
VITE_API_URL=http://localhost:3000/api
# Titular del servicio [PROD, OBLIGATORIO]: lo publican el Aviso Legal (LSSI art. 10) y la Politica de Privacidad (RGPD art. 13).
# `vite build` en modo produccion FALLA si NAME, NIF, ADDRESS o EMAIL estan vacios. En desarrollo se ven marcadores
# "[... - pendiente]". Vite lee estas variables del entorno o de packages/frontend/.env.local; con Docker se pasan como
# build args (docker-compose.prod.yml) y en Render se definen en el servicio mockia-frontend (render.yaml, sync: false).
VITE_LEGAL_NAME=
VITE_LEGAL_NIF=
VITE_LEGAL_ADDRESS=
VITE_LEGAL_EMAIL=
# Datos registrales (p. ej. Registro Mercantil): opcional.
VITE_LEGAL_REGISTRY=
# Solo CI/pruebas: 1 permite compilar para produccion con marcadores en lugar de los datos. NUNCA en un despliegue real.
VITE_LEGAL_ALLOW_PLACEHOLDER=
# [PROD] Origen(es) explicito(s) del frontend, separados por comas. Nunca "*".
CORS_ORIGIN=http://localhost:5173

# MongoDB Configuration [PROD]
# Estos valores van incrustados en MONGODB_URI: usa solo caracteres seguros para URL (openssl rand -hex 24).
# La contrasena "password" solo vale en desarrollo; con ella el backend no arranca en produccion.
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=password

# Logging
LOG_LEVEL=debug

# --- Public demo (anonymous AI generation without an account) ---------------------------------------------------
# OFF by default. To open it: DEMO_ENABLED=true and a random DEMO_HMAC_SECRET (>= 32 chars; it signs the proof-of-work
# challenges and pseudonymizes visitor IPs, so rotating it only invalidates pending challenges).
DEMO_ENABLED=false
DEMO_HMAC_SECRET=
DEMO_DAILY_GENERATIONS=150
DEMO_PER_IP_GENERATIONS=2
DEMO_MAX_CONCURRENT=4
# Daily generations for a whole IPv6 /48 (one person with a free tunnel owns 65 536 /64, each with its own per-visitor allowance); IPv4 is not counted.
DEMO_PER_NET_GENERATIONS=20
DEMO_POW_BITS=18
DEMO_MOCK_TTL_MINUTES=30
# Optional: provider list for the DEMO only (same syntax as AI_PROVIDERS, e.g. a cheaper or local model). Empty = use AI_PROVIDERS.
# The demo asks for at most 5 endpoints and 2000 output tokens per generation, whatever the model, and always uses its own
# provider chain and circuit breakers (a failing demo never cuts the AI of registered users).
AI_DEMO_PROVIDERS=
# Overall deadline of one demo generation in ms (default 45000). A request already sent counts as spent budget even on timeout.
AI_DEMO_TIMEOUT_MS=
