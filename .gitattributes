# Auto detect text files and normalize line endings to LF
* text=auto eol=lf

# Source files
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf

# Config files
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf

# Markup and docs
*.html text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.md text eol=lf
*.xml text eol=lf

# Shell and scripting
*.sh text eol=lf
Makefile text eol=lf
Dockerfile* text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.ttf binary
*.otf binary
